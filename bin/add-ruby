#!/usr/bin/env bash
set -euo pipefail

read -r -p "Enter new Ruby version: " ruby_version

if [[ ! "$ruby_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "Enter an exact Ruby version, for example 4.0.2." >&2
  exit 1
fi

if ! command -v rv >/dev/null 2>&1; then
  echo "rv not found. Install it first: brew install rv" >&2
  exit 1
fi

# Only change the default after installation succeeds. Write directly to the
# home version file so running from a project cannot change its Ruby pin.
rv ruby install "$ruby_version"
printf '%s\n' "$ruby_version" >"$HOME/.ruby-version"
echo "Default Ruby set to $ruby_version in $HOME/.ruby-version."
echo "Open a new shell to activate it. Project version files take precedence."
